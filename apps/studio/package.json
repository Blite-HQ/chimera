{
  "name": "@chimera/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chimera Studio — research UI for trustworthy agentic science.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
