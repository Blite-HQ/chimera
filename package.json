{
  "name": "chimera-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open platform for trustworthy agentic scientific research.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "pnpm -C apps/studio exec depcruise src",
    "docs:lint": "markdownlint '**/*.md' --ignore node_modules --ignore '**/node_modules/**'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "dependency-cruiser": "^18.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli": "^0.49.0",
    "prettier": "^3.9.4"
  },
  "lint-staged": {
    "*.py": [
      "uv run ruff format",
      "uv run ruff check --fix"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ],
    "apps/studio/**/*.{ts,tsx,js,jsx}": [
      "pnpm -C apps/studio exec eslint --fix",
      "pnpm -C apps/studio exec prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "semi": true,
    "tabWidth": 2,
    "printWidth": 100,
    "arrowParens": "avoid"
  }
}
