{
  "name": "chimera-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open platform for trustworthy agentic scientific research.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "pnpm -C apps/studio exec depcruise src",
    "docs:lint": "markdownlint '**/*.md' --ignore node_modules --ignore '**/node_modules/**'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "dependency-cruiser": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "*.py": [
      "uv run ruff format",
      "uv run ruff check --fix"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint --fix"
    ],
    "apps/studio/**/*.{ts,tsx,js,jsx}": [
      "pnpm -C apps/studio exec eslint --fix",
      "pnpm -C apps/studio exec prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "semi": true,
    "tabWidth": 2,
    "printWidth": 100,
    "arrowParens": "avoid"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "chore",
          "ci",
          "build",
          "revert"
        ]
      ],
      "subject-case": [
        2,
        "never",
        [
          "sentence-case",
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "header-max-length": [
        2,
        "always",
        100
      ]
    }
  }
}
