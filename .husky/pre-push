#!/bin/sh
# Lightweight architecture gate before push (full gate runs in CI)
set -e
echo "[pre-push] Checking import boundaries..."
uv run lint-imports --no-cache
echo "[pre-push] Checking TypeScript..."
pnpm -C apps/studio exec tsc --noEmit
echo "[pre-push] Running invariant tests..."
uv run pytest tests/invariants -q --no-cov -p no:cacheprovider
echo "[pre-push] Done."
