# Copy to .env and fill in real values. Never commit .env (see .gitignore).
# This file documents every environment variable the repo currently reads —
# add new vars here in the same PR that introduces them (OWASP A05 / secret
# hygiene: no secret name or value should ever be invented inline in code).

# apps/studio — base URL the Studio UI uses to reach the gateway.
# Read in apps/studio/src/gatewayClient.ts via import.meta.env.VITE_GATEWAY_URL
VITE_GATEWAY_URL=http://localhost:8000

# apps/studio — live-mode toggle: unset = fixtures/demo mode, set = the data
# layer talks to the real API (decisiones #46/#49).
# Read in apps/studio/src/data/env.ts via import.meta.env.VITE_API_URL
VITE_API_URL=

# Compose/tests vars (CHIMERA_DATABASE_URL, CHIMERA_DB_PASSWORD_FILE,
# CHIMERA_TEST_DATABASE_URL) are documented in compose.yaml and the infra docs
# (docs/mvp/infra-verificacion.md), not here.

# Ollama Cloud passthrough (ratificacion Geovanni item-4); custody escalon 1.
# Breaks air-gap -> Fase 2 for the offline enclosure. Never hardcode in compose.
OLLAMA_API_KEY=
