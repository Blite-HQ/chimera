# Copy to .env and fill in real values. Never commit .env (see .gitignore).
# This file documents every environment variable the repo currently reads —
# add new vars here in the same PR that introduces them (OWASP A05 / secret
# hygiene: no secret name or value should ever be invented inline in code).

# VITE_GATEWAY_URL fue RETIRADA (hallazgo 7, P-rt 2026-08-02): solo la leía
# `invokeCapability()` para armar la URL de `POST /invoke`, una ruta que ningún
# servidor implementó jamás. Se mató la ruta (habría sido una segunda vía de
# invocar capabilities evadiendo run/claim/verificación) y con ella su variable.
# El Studio alcanza la API con VITE_API_URL.

# apps/studio — live-mode toggle: unset = fixtures/demo mode, set = the data
# layer talks to the real API (decisiones #46/#49).
# Read in apps/studio/src/data/env.ts via import.meta.env.VITE_API_URL
VITE_API_URL=

# Compose/tests vars (CHIMERA_DATABASE_URL, CHIMERA_DB_PASSWORD_FILE,
# CHIMERA_TEST_DATABASE_URL) are documented in compose.yaml and the infra docs
# (docs/mvp/infra-verificacion.md), not here.

# api — F1.6: where run EVIDENCE lives (RunResources.content, what
# digest_via() persists on every run.step.started/capability.job.*/model
# call). Different trust plane than CHIMERA_FILES_DIR (compose.yaml-only,
# not listed here): that one is user-uploaded papers, this one is what the
# runtime itself produces and the certificate cites — see files.py:73-84 for
# why they don't share a directory. Absent => InMemoryContentStore (Phase 1
# fallback, explicit and logged, never silent) — evidence is ephemeral
# again, which is the exact behavior this variable exists to change.
# compose.yaml always sets it for the api service. Read in
# api/src/chimera_api/runs.py.
CHIMERA_CONTENT_DIR=

# api — proposer/model backend selector (fail-fast: misconfiguration is a
# startup error, never a silent fallback). Read in api/src/chimera_api/runs.py.
# Values: replay | record | live (freeze §15.7; the frozen letter's old name
# MODEL_ROUTER_BACKEND was never implemented — reconciliation note N12).
CHIMERA_MODEL_BACKEND=

# api — session directory for replay/record mode (required when
# CHIMERA_MODEL_BACKEND=replay; produced by scripts/record_session.py).
CHIMERA_MODEL_SESSION_DIR=

# api — model identifier for the live backend.
CHIMERA_MODEL_ID=

# OLLAMA_API_KEY was removed by the S3 sanitation (2026-07-30): no executable
# reads it (it was a residue of a hackathon-era ratification — see
# docs/archivo/ratificaciones/geovanni-plano-infra.md). If an Ollama Cloud
# backend returns, its key enters via *_FILE secrets, not here.

# --- Sesión del API (C2/M2, freeze §9 P1-9) ---
# Identidad del operador del despliegue (doctrina §7: quién actúa es dato del
# despliegue). Default: user:local-operator con los permisos baseline.
CHIMERA_OPERATOR_ID=
# Permisos del operador, separados por coma (default: capability:invoke,
# capability:ingest:external-source, capability:ingest:derive) — setear esta
# var REEMPLAZA el default entero, no lo extiende. compose.yaml la define
# explícita para el servicio api, agregando `override:apply:run`: sin ese
# permiso, POST /runs/{id}/approvals/{id} da 403 fail-closed (el default de
# código NO lo trae a propósito — chimera_api.chat._APPROVAL_SCOPE). Que
# responder aprobaciones exija ese permiso es explícito, nunca automático.
CHIMERA_OPERATOR_PERMISSIONS=
# Cookie de sesión con atributo Secure — OBLIGATORIO en despliegues TLS
# (Fargate); apagado en el walking skeleton http://localhost (una cookie
# Secure en http plano se descarta en silencio).
CHIMERA_SESSION_COOKIE_SECURE=

# --- Aprobación humana en el camino de misión (F1.3) ---
# api — side_effects (CapabilityManifest, separados por coma) que exigen
# aprobación humana ANTES de invocar la capability propuesta por el turno
# agéntico (docs/specs/harness-agentico.md §Contrato-6). Read in
# api/src/chimera_api/runs.py (_build_approval_gate). AUSENTE o vacía (el
# default) ⇒ SIN gate — cero aprobaciones fabricadas
# (blite.runtime.mission.ApprovalGate ya documenta esa doctrina); el gate no
# bloquea esperando la respuesta humana (mission.py:132-141) — niega
# fail-closed y deja el approval.requested real journalizado para que
# POST /runs/{id}/approvals/{id} lo responda después.
# Ejemplo: CHIMERA_APPROVAL_REQUIRED_SIDE_EFFECTS=irreversible-external
CHIMERA_APPROVAL_REQUIRED_SIDE_EFFECTS=

# --- Agente real / sesión grabada (P4/M31) ---
# API key del proveedor de modelo POR ARCHIVO (nunca por env: una env var se
# filtra por `docker inspect`, por /proc/<pid>/environ y por los volcados de
# crash). Solo hace falta con CHIMERA_MODEL_BACKEND=record|live — el modo
# replay es air-gapped por construcción. La env var explícita
# CHIMERA_MODEL_API_KEY gana sobre el archivo (para depurar a mano).
CHIMERA_MODEL_API_KEY_FILE=
# Arrancar la API con CHIMERA_MODEL_BACKEND=record FALLA a propósito: ese modo
# graba a un manifest EFÍMERO (en memoria) que se pierde al reiniciar, pagando
# llamadas de modelo reales por nada. Para grabar de verdad:
# scripts/record_session.py. Poné 1 solo si querés el modo efímero a sabiendas.
CHIMERA_ALLOW_EPHEMERAL_RECORD=
