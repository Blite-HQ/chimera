# Copy to .env and fill in real values. Never commit .env (see .gitignore).
# This file documents every environment variable the repo currently reads —
# add new vars here in the same PR that introduces them (OWASP A05 / secret
# hygiene: no secret name or value should ever be invented inline in code).

# apps/studio — base URL the Studio UI uses to reach the gateway.
# Read in apps/studio/src/gatewayClient.ts via import.meta.env.VITE_GATEWAY_URL
VITE_GATEWAY_URL=http://localhost:8000

# apps/studio — live-mode toggle: unset = fixtures/demo mode, set = the data
# layer talks to the real API (decisiones #46/#49).
# Read in apps/studio/src/data/env.ts via import.meta.env.VITE_API_URL
VITE_API_URL=

# Compose/tests vars (CHIMERA_DATABASE_URL, CHIMERA_DB_PASSWORD_FILE,
# CHIMERA_TEST_DATABASE_URL) are documented in compose.yaml and the infra docs
# (docs/mvp/infra-verificacion.md), not here.

# api — proposer/model backend selector (fail-fast: misconfiguration is a
# startup error, never a silent fallback). Read in api/src/chimera_api/runs.py.
# Values: replay | record | live (freeze §15.7; the frozen letter's old name
# MODEL_ROUTER_BACKEND was never implemented — reconciliation note N12).
CHIMERA_MODEL_BACKEND=

# api — session directory for replay/record mode (required when
# CHIMERA_MODEL_BACKEND=replay; produced by scripts/record_session.py).
CHIMERA_MODEL_SESSION_DIR=

# api — model identifier for the live backend.
CHIMERA_MODEL_ID=

# OLLAMA_API_KEY was removed by the S3 sanitation (2026-07-30): no executable
# reads it (it was a residue of a hackathon-era ratification — see
# docs/archivo/ratificaciones/geovanni-plano-infra.md). If an Ollama Cloud
# backend returns, its key enters via *_FILE secrets, not here.

# --- Sesión del API (C2/M2, freeze §9 P1-9) ---
# Identidad del operador del despliegue (doctrina §7: quién actúa es dato del
# despliegue). Default: user:local-operator con los permisos baseline.
CHIMERA_OPERATOR_ID=
# Permisos del operador, separados por coma (default: capability:invoke,
# capability:ingest:external-source, capability:ingest:derive).
CHIMERA_OPERATOR_PERMISSIONS=
# Cookie de sesión con atributo Secure — OBLIGATORIO en despliegues TLS
# (Fargate); apagado en el walking skeleton http://localhost (una cookie
# Secure en http plano se descarta en silencio).
CHIMERA_SESSION_COOKIE_SECURE=
